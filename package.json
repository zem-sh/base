{
  "name": "core-zem",
  "version": "1.0.0",
  "private": true,
  "description": "Zem core addon + pane extension — terminal, explorer, stats, version control, notes and status items",
  "type": "module",
  "scripts": {
    "build": "pnpm build:pane",
    "build:pane": "vite build && node scripts/assert-host-covered.mjs",
    "build:addon": "cargo build --release",
    "generate:addon-manifest": "cargo run --release -- --generate-manifest",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@react-symbols/icons": "^1.3.1",
    "@visx/curve": "4.0.1-alpha.0",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "@zem-sh/pane": "^0.1.0",
    "@zem-sh/terminal": "^0.1.2",
    "@mynaui/icons-react": "^0.4.2",
    "d3-array": "^3.2.4",
    "react-use-measure": "^2.1.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.2.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.4",
    "zustand": "^5.0.13"
  }
}
